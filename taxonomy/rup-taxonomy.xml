        <taxonomy xml:id="latin_source_genres">
          <desc>Latin genre terms</desc>

          <category xml:id="epicedium">
            <catDesc>Funeral poem (epicedium)</catDesc>
          </category>
          <category xml:id="amores">
            <catDesc>Love poems/elegies</catDesc>
          </category>
          <category xml:id="epitaphium">
            <catDesc>Epitaph (epitaphium)</catDesc>
          </category>
          <category xml:id="epithalamium">
            <catDesc>Marriage poem (epithalamium)</catDesc>
            <!-- wedding songs in varous metres -->
          </category>
          <category xml:id="genethliakon">

            <catDesc>Birth poem (genethliakon)</catDesc>
          </category>
          <category xml:id="panegyric">
            <catDesc>Panegyric</catDesc>
            <!-- an encomiastic poem ususlly addressed to the assembled multitude -->
          </category>
          <category xml:id="paedeuterion">
            <catDesc>Thanks to teacher (paedeuterion)</catDesc>
            <!-- in which thanks are expressed to the teacher for the instruction given -->
          </category>
          <category xml:id="eucharisticon">
            <catDesc>Thanksgiving poem (eucharisticon)</catDesc>
            <!-- a poem which contains expressions of thanks (actiones gratiarum); closely akin gto the Latin 'Gratulatio' -->
          </category>

          <category xml:id="encomion">
            <catDesc>Praise poem (encomion)</catDesc>
            <!-- Encomiasticon, Encomion, Epaeneticon, genres which rehearse praise -->
          </category>

          <category xml:id="Symbuleuticon">
            <catDesc>Debate poem</catDesc>
            <!--  a deliberative poem which debates issues (e.g. Should war be declared?) -->
          </category>

          <category xml:id="apobaterion">
            <catDesc>Departure poem (apobaterion)</catDesc>
            <!-- uttered by departing travellers -->
          </category>
          <category xml:id="epibaterion">
            <catDesc>Return poem (epibaterion)</catDesc>
            <!-- a traveller's return to his native land after a long absense is celebrated -->
          </category>
          <category xml:id="symbuleuticon">
            <catDesc>Deliberative poem (symbuleuticon)</catDesc>
          </category>
          <category xml:id="protreptic">
            <catDesc>Exhortatory poem (protreptic)</catDesc>
            <!-- protreptic, or exhortation to seek virtue and wisdom -->
          </category>

          <category xml:id="proseucticon">
            <catDesc>Petitionary prayer poem (proseucticon)</catDesc>
            <!-- Proseucticon, containing a petition for something to be done; similar to the Eucticon, a poem expressing a prayer of wish -->
          </category>
          <category xml:id="eucticon">
            <catDesc>Poem expresing a prayer or wish (eucticon)</catDesc>
          </category>

          <category xml:id="apeucticon">
            <catDesc>Negative petition poem (apeucticon)</catDesc>
            <!-- asking that something should not be done -->
          </category>

          <category xml:id="soteria">
            <catDesc>Deliverance poem (soteria)</catDesc>
            <!-- a poem celebrating the safe return of a leader or army, or restoration to health of a friend or relative e.g. the Oxford anthology on the recovery from illness of King Charles I  -->
          </category>

          <category xml:id="eroticon">
            <catDesc>Love poem (eroticon)</catDesc>
            <!-- a poem declaring one's love -->
          </category>
          <category xml:id="propempticon">
            <catDesc>Farewell poem for a traveller (propempticon)</catDesc>
          </category>
          <category xml:id="apopempticon">
            <catDesc>Pilgrimage poem (apopempticon)</catDesc>
          </category>
          <category xml:id="hodoeporicon">
            <catDesc>Journey poem (hodoeporicon)</catDesc>
          </category>
          <category xml:id="amoebaean_verse">
            <catDesc>Responsive / amoebaean verse</catDesc>
          </category>
          <category xml:id="cinaedic_verse">
            <catDesc>Obscene or licentious verse (cinaedic / fescennine)</catDesc>
          </category>
          <category xml:id="dirae">
            <catDesc>Curse poem (dirae)</catDesc>
          </category>
          <category xml:id="mimus">
            <catDesc>Comic dramatic piece (mimus)</catDesc>
          </category>
          <category xml:id="palinode_latin">
            <catDesc>Recantation poem (palinode)</catDesc>
          </category>
          <category xml:id="dithyramb">
            <catDesc>Bacchic hymn (dithyramb)</catDesc>
          </category>
          <category xml:id="triumph_poem">
            <catDesc>Victory poem (triumph poem / thriambeuticon)</catDesc>
          </category>
          <category xml:id="prosphonetikon">
            <catDesc>Welcome poem (prosphonetikon)</catDesc>
          </category>
          <category xml:id="prosopopoeia_latin">
            <catDesc>Persona speech (prosopopoeia)</catDesc>
          </category>
        </taxonomy>

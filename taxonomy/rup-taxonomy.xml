        <taxonomy xml:id="form_features">
          <desc>Formal or rhetorical features that are not stable genres.</desc>
          <category xml:id="acrostic">
            <catDesc>Acrostic</catDesc>
            <!-- in acrostic verses, the first letter of each line forms a name or message; e.g. in Luctus posthumus (1612) on the death of Prince Henry, the initial letters of each line spell out PRINCEPS, while the last letters form Henricus -->
          </category>
          <category xml:id="anagram">
            <catDesc>Anagram</catDesc>
          </category>
          <category xml:id="latticed">
            <catDesc>Latticed</catDesc>
            <!-- Latticed or Tesselated verses where the words of the poem can be read downwards, as well as across -->
          </category>
          <category xml:id="figure_poem">
            <catDesc>Figure poem</catDesc>
            <!-- figure poems in the shape of an altar, an egg, a pair of wings; according to Binns (p. 51)  Richard Wills was only the second English poet ... to compose figure poems. Found in University memorial collections of verse e.g. one on death of Sir Philip Sydney. Not found much in ms? -->
          </category>
          <category xml:id="enigma">
            <catDesc>Enigma / riddle</catDesc>
          </category>
          <category xml:id="versus_rapportati">
            <catDesc>Versus rapportati</catDesc>
            <!-- similarly constructed clauses are broken up and dovetailed together in a new rod order; also called carmen correlativum -->
          </category>
          <category xml:id="echo_verses">
            <catDesc>Echo verses</catDesc>
          </category>
          <category xml:id="answer_poem">
            <catDesc>Answer poem</catDesc>
          </category>
          <category xml:id="double_reading">
            <catDesc>Double reading</catDesc>
            <!-- Carmen reciprocum, a poem with directly opposite meanings when read backwards and forwards -->
          </category>
          <category xml:id="palinode">
            <catDesc>Palinode / recantation</catDesc>
          </category>
          <category xml:id="prosopopoeia">
            <catDesc>Prosopopoeia</catDesc>
          </category>
          <category xml:id="apostrophe">
            <catDesc>Apostrophe</catDesc>
          </category>
          <category xml:id="amoebaean">
            <catDesc>Amoebaean / responsive verse</catDesc>
          </category>
          <category xml:id="fescennine">
            <catDesc>Fescennine / obscene jocularity</catDesc>
          </category>
        </taxonomy>

        <taxonomy xml:id="social_relation">
          <desc>Social directionality or target relation, especially useful for satire and
            libel.</desc>
          <category xml:id="horizontal_satire">
